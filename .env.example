# Copy to .env and fill in. Never commit the real file -- it's gitignored.

DATABASE_URL=postgresql://spequla:spequla@localhost:5432/spequla

OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=spequla
OBJECT_STORE_SECRET_KEY=spequla_dev_only
OBJECT_STORE_BUCKET=spequla-raw

# From the WorkOS dashboard (Applications -> your app -> API keys / AuthKit).
# See docs/workos_setup.md for the full walkthrough -- account creation and
# key generation are steps only the WorkOS account owner can do.
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
